{
  "name": "@framepilot/shared-types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript types and utilities for FramePilot packages.",
  "license": "SEE LICENSE IN ../../LICENSE",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./safety": {
      "types": "./dist/safety.d.ts",
      "default": "./dist/safety.js"
    },
    "./projects-root": {
      "types": "./dist/projects-root.d.ts",
      "default": "./dist/projects-root.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.9.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.6"
  }
}
