{
  "name": "@framepilot/ai-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Multi-provider AI layer (Anthropic, NVIDIA, mock) — tool registry, orchestrator, context builder (PRD §8).",
  "license": "SEE LICENSE IN ../../LICENSE",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate:skills": "node scripts/generate-skills.mjs",
    "generate:model-capabilities": "node scripts/generate-model-capabilities.mjs",
    "generate:autonomous-tools": "node scripts/generate-autonomous-tools.mjs",
    "generate:tool-parity": "node scripts/generate-tool-parity-fixture.mjs",
    "build": "node scripts/generate-skills.mjs && node scripts/generate-model-capabilities.mjs && tsc -b && node scripts/generate-tool-parity-fixture.mjs && node scripts/generate-tool-descriptions.mjs && node scripts/generate-autonomous-tools.mjs",
    "eval:foundation:real": "node scripts/run-foundation-real-eval.mjs",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "eval:golden": "node scripts/mission-baseline.mjs",
    "eval:golden:gate": "node scripts/golden-gate.mjs",
    "eval:mission": "node scripts/golden-gate.mjs reports/golden/baseline.json",
    "eval:mission:real": "node scripts/mission-baseline.mjs --case montage-30s,podcast-highlight-60s,remove-dead-air,beat-sync,refine-tighten,memory-captions --runs 3 --label nightly --force --yes --dump-events --out reports/golden/nightly.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.259",
    "@framepilot/capability-packs": "workspace:*",
    "@framepilot/editor-core": "workspace:*",
    "@framepilot/shared-types": "workspace:*",
    "@framepilot/timeline-schema": "workspace:*",
    "@langchain/anthropic": "1.5.9",
    "@langchain/core": "1.2.9",
    "@langchain/deepseek": "1.1.11",
    "@langchain/google-genai": "2.3.0",
    "@langchain/groq": "1.3.1",
    "@langchain/langgraph": "1.4.13",
    "@langchain/ollama": "1.3.0",
    "@langchain/openai": "1.5.11",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.9.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.6"
  }
}
