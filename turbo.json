{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_MODEL",
    "ANTHROPIC_BASE_URL",
    "NVIDIA_API_KEY",
    "NVIDIA_MODEL",
    "NVIDIA_BASE_URL",
    "FRAMEPILOT_NVIDIA_EMBEDDINGS_KEYS",
    "TWELVELABS_API_KEY",
    "OPENROUTER_API_KEY",
    "OPENROUTER_MODEL",
    "OPENROUTER_BASE_URL",
    "GROQ_API_KEY",
    "GROQ_MODEL",
    "GROQ_BASE_URL",
    "FRAMEPILOT_ASR_GROQ_MODEL",
    "FRAMEPILOT_ASR_NVIDIA_MODEL",
    "FRAMEPILOT_ASR_API_KEY",
    "FRAMEPILOT_ASR_PROVIDER",
    "GOOGLE_API_KEY",
    "GOOGLE_MODEL",
    "GOOGLE_BASE_URL",
    "GOOGLE_VERTEX_MODEL",
    "GOOGLE_CLOUD_PROJECT",
    "GOOGLE_CLOUD_LOCATION",
    "GOOGLE_APPLICATION_CREDENTIALS",
    "GOOGLE_GENAI_USE_ENTERPRISE",
    "GOOGLE_GENAI_USE_VERTEXAI",
    "OLLAMA_API_KEY",
    "OLLAMA_MODEL",
    "OLLAMA_BASE_URL",
    "DEEPSEEK_API_KEY",
    "DEEPSEEK_MODEL",
    "DEEPSEEK_BASE_URL",
    "FRAMEPILOT_OPENAI_COMPATIBLE_API_KEY",
    "FRAMEPILOT_OPENAI_COMPATIBLE_MODEL",
    "FRAMEPILOT_OPENAI_COMPATIBLE_BASE_URL",
    "FRAMEPILOT_AI_PROVIDER",
    "FRAMEPILOT_TIER_SMALL_PROVIDER",
    "FRAMEPILOT_TIER_SMALL_MODEL",
    "FRAMEPILOT_TIER_MID_PROVIDER",
    "FRAMEPILOT_TIER_MID_MODEL",
    "FRAMEPILOT_TIER_LARGE_PROVIDER",
    "FRAMEPILOT_TIER_LARGE_MODEL",
    "FRAMEPILOT_AI_MAX_TOKENS",
    "FRAMEPILOT_MAX_TOOL_CONCURRENCY",
    "FRAMEPILOT_MAX_REVIEW_CONCURRENCY",
    "FRAMEPILOT_PYTHON_API_URL",
    "FRAMEPILOT_PYTHON_API_HOST",
    "FRAMEPILOT_PYTHON_API_PORT",
    "FRAMEPILOT_CORS_ORIGINS",
    "FRAMEPILOT_ENGINE_DIR",
    "FRAMEPILOT_SIDECAR_TIMEOUT_MS",
    "FRAMEPILOT_PROJECTS_ROOT",
    "FRAMEPILOT_RENDER_TIMEOUT_SECONDS",
    "FRAMEPILOT_ASSET_MEDIA_TIMEOUT_SECONDS",
    "FRAMEPILOT_PROXY_TIMEOUT_SECONDS",
    "FRAMEPILOT_PROXY_MAX_DURATION_SECONDS",
    "FRAMEPILOT_EMBEDDINGS_MODEL_DIR",
    "FRAMEPILOT_SOUL_ROOT",
    "FRAMEPILOT_LOG_LEVEL",
    "LOG_LEVEL",
    "FRAMEPILOT_WHISPER_CLI",
    "FRAMEPILOT_ASR_MODEL_DIR",
    "FRAMEPILOT_ASR_CACHE_DIR",
    "FRAMEPILOT_FFPROBE",
    "FRAMEPILOT_FFMPEG",
    "CSC_NAME",
    "PYTHON_PATH",
    "FRAMEPILOT_FREEMIUS_PRODUCT_ID",
    "FRAMEPILOT_LICENSE_DEV_BYPASS",
    "FREEMIUS_PRODUCT_ID",
    "FREEMIUS_SECRET_KEY",
    "FREEMIUS_PUBLIC_KEY",
    "FREEMIUS_BEARER_TOKEN",
    "NEXT_PUBLIC_FREEMIUS_PRODUCT_ID",
    "NEXT_PUBLIC_FREEMIUS_PUBLIC_KEY",
    "NEXT_PUBLIC_FREEMIUS_PLAN_ID_MONTHLY",
    "NEXT_PUBLIC_FREEMIUS_PLAN_ID_ANNUAL",
    "NEXT_PUBLIC_FREEMIUS_PLAN_ID",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_DEMO_YOUTUBE_ID"
  ],
  "globalDependencies": [".env", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**", "../../reports/coverage/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
