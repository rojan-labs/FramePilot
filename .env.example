# ─────────────────────────────────────────────────────────────────────────────
# FramePilot environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`. Secrets stay local-first.
# ─────────────────────────────────────────────────────────────────────────────

# Default AI provider used when Settings has not selected another provider.
# The roster below is the one in packages/ai-sdk/src/providers/types.ts
# (PROVIDER_NAMES), mirrored by AIProvider in engine/python/.../config.py:
# anthropic | nvidia | openrouter | groq | google | ollama | deepseek |
# openai-compatible | mock
# `mock` returns deterministic canned patches for tests and offline development.
FRAMEPILOT_AI_PROVIDER=mock

# --- Anthropic (Claude) ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- NVIDIA chat (NIM / build.nvidia.com) ---
# https://build.nvidia.com/  (OpenAI-compatible endpoint)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA API key(s) for VISUAL EMBEDDINGS, comma-separated and rotated on
# failure. This is a separate slot from NVIDIA_API_KEY because chat and visual
# embedding calls have different behavior. Configuring these keys permits
# sampled frames to be sent to NVIDIA for hosted embedding generation.
FRAMEPILOT_NVIDIA_EMBEDDINGS_KEYS=

# --- OpenRouter ---
# https://openrouter.ai/keys  (OpenAI-compatible endpoint)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Vercel AI Gateway ---
# https://vercel.com/docs/ai-gateway  (OpenAI-compatible endpoint; model ids are
# `provider/model` slugs, e.g. anthropic/claude-sonnet-4.6). AI_GATEWAY_API_KEY is
# Vercel's own variable name for this credential.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# --- Groq ---
# https://console.groq.com/keys  (OpenAI-compatible endpoint)
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Optional Groq model override for ASR/transcription. This is separate from the
# chat model above.
FRAMEPILOT_ASR_GROQ_MODEL=

# --- Agent outcome evaluation (pnpm eval:agent:foundation:real) ---
# Absolute path to a real project file (.fp.json) to measure instead of the tiny built-in
# test fixture. Unset = fixture, whose latency numbers describe a few seconds of media and
# support no claim about real footage. Set this to report desktop-scale latency honestly.
FRAMEPILOT_EVAL_PROJECT=

# --- Google Gemini (Developer API / AI Studio) ---
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- GitHub Models ---
# https://github.com/marketplace/models
GITHUB_MODELS_PAT=
GITHUB_MODELS_MODEL=

# --- GitHub Copilot ---
GITHUB_COPILOT_TOKEN=
GITHUB_COPILOT_MODEL=

# --- Ollama (local or self-hosted) ---
# https://ollama.com/
OLLAMA_API_KEY=
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# --- DeepSeek ---
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Any OpenAI-compatible server (self-hosted gateway or local proxy) ---
# vLLM, LM Studio, llama.cpp, LiteLLM, or a local subscription proxy. Unlike every
# provider above this has NO default endpoint — the URL is the whole configuration,
# and without it the provider fails with an actionable error rather than calling
# somebody else's API. Point it at the root that serves /chat/completions. The key is
# optional: most self-hosted servers ignore it.
FRAMEPILOT_OPENAI_COMPATIBLE_BASE_URL=
FRAMEPILOT_OPENAI_COMPATIBLE_API_KEY=
FRAMEPILOT_OPENAI_COMPATIBLE_MODEL=

# --- Hosted media understanding (optional) ---
# Configuring this key permits selected media data to be sent to TwelveLabs for
# supported analysis and transcription workflows.
TWELVELABS_API_KEY=

# --- Transcription (optional) ---
# Used by supported hosted transcription paths.
OPENAI_API_KEY=
WHISPER_MODEL=base

# --- Python sidecar service ---
FRAMEPILOT_PYTHON_API_URL=http://127.0.0.1:8765
FRAMEPILOT_PYTHON_API_HOST=127.0.0.1
FRAMEPILOT_PYTHON_API_PORT=8765
# Comma-separated CORS origins accepted by the sidecar. The default covers the
# Vite development server and packaged Electron renderer.
FRAMEPILOT_CORS_ORIGINS=

# --- MCP server (loopback Streamable HTTP) ---
FRAMEPILOT_MCP_HOST=127.0.0.1
FRAMEPILOT_MCP_PORT=19789
FRAMEPILOT_MCP_PATH=/mcp

# --- Desktop app and sidecar ---
# Force the desktop shell to run the engine from source in this directory, even
# in a packaged build. Normal packaged builds spawn the bundled PyInstaller
# engine under Resources/engine.
FRAMEPILOT_ENGINE_DIR=
# How long the desktop host waits for the sidecar health check during startup.
FRAMEPILOT_SIDECAR_TIMEOUT_MS=15000

# --- Desktop packaging and release, build machines only ---
# macOS signing identity shared by the bundled-engine signing helper and
# Electron Builder. Unset creates an unsigned local build. `-` uses ad-hoc
# signing. Notarization also reads APPLE_ID, APPLE_APP_SPECIFIC_PASSWORD, and
# APPLE_TEAM_ID from the secure release environment.
CSC_NAME=
# electron-builder's dmg tooling can require an explicit Python executable on
# machines that have python3 but no python shim.
PYTHON_PATH=

# --- ASR / Whisper ---
# Path to a whisper.cpp-compatible CLI. Packaged builds can inject a staged
# binary automatically. An explicit value always wins.
FRAMEPILOT_WHISPER_CLI=
# Directory holding downloaded local Whisper models.
FRAMEPILOT_ASR_MODEL_DIR=
# Directory holding cached ASR artifacts.
FRAMEPILOT_ASR_CACHE_DIR=
# Advanced checksum override naming convention:
# FRAMEPILOT_ASR_<MODEL_UPPER>_SHA256, for example FRAMEPILOT_ASR_BASE_SHA256.

# --- ffmpeg / ffprobe ---
# Development resolution checks these values, PATH, and supported fallbacks.
# Packaged builds stage both binaries and inject their resolved locations.
FRAMEPILOT_FFPROBE=
FRAMEPILOT_FFMPEG=

# --- Runtime and safety budgets ---
# Absolute project sandbox root. Defaults to the application project location.
FRAMEPILOT_PROJECTS_ROOT=
# Maximum duration of one render job.
FRAMEPILOT_RENDER_TIMEOUT_SECONDS=900
# Maximum duration of probe, waveform, thumbnail, and related media derivation.
FRAMEPILOT_ASSET_MEDIA_TIMEOUT_SECONDS=60
# Maximum preview proxy transcode duration.
FRAMEPILOT_PROXY_TIMEOUT_SECONDS=300
# Sources longer than this skip synchronous proxy generation.
FRAMEPILOT_PROXY_MAX_DURATION_SECONDS=900
# Maximum model tokens budgeted for one orchestration request.
FRAMEPILOT_AI_MAX_TOKENS=8192
# Maximum parallel concurrency-safe read and analysis tools in one turn.
FRAMEPILOT_MAX_TOOL_CONCURRENCY=4
# Perceptual reviews allowed to run at once during an agent run (ADR 0123).
# One review is a batch of real rendered frames at project resolution, so this
# multiplies gigabytes, not milliseconds. Raise only with UHD-scale evidence.
FRAMEPILOT_MAX_REVIEW_CONCURRENCY=1
# Optional local ONNX model directory containing model.onnx and tokenizer.json.
# When absent, similarity search degrades to keyword search.
FRAMEPILOT_EMBEDDINGS_MODEL_DIR=
# Sidecar and engine logging.
FRAMEPILOT_LOG_LEVEL=info
LOG_LEVEL=info
# Cross-project working-style memory root.
FRAMEPILOT_SOUL_ROOT=~/.framepilot

# ─────────────────────────────────────────────────────────────────────────────
# Licensing (Freemius), desktop app
# ─────────────────────────────────────────────────────────────────────────────
# Product id validated by the desktop license gate. The FRAMEPILOT-prefixed
# value takes precedence over FREEMIUS_PRODUCT_ID.
FRAMEPILOT_FREEMIUS_PRODUCT_ID=
# Local development only. Never enable in a production build.
FRAMEPILOT_LICENSE_DEV_BYPASS=

# ─────────────────────────────────────────────────────────────────────────────
# Marketing website, Freemius checkout and pricing
# NEXT_PUBLIC_* values are exposed to the browser. Bare FREEMIUS_* credentials
# are server-only. Hosted builds must receive public variables in their build
# environment because local .env files are not automatically available there.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FREEMIUS_PRODUCT_ID=
NEXT_PUBLIC_FREEMIUS_PUBLIC_KEY=
NEXT_PUBLIC_FREEMIUS_PLAN_ID_MONTHLY=
NEXT_PUBLIC_FREEMIUS_PLAN_ID_ANNUAL=
NEXT_PUBLIC_SITE_URL=https://framepilot.app
NEXT_PUBLIC_DEMO_YOUTUBE_ID=

# Server-only pricing synchronization.
FREEMIUS_PRODUCT_ID=
FREEMIUS_PUBLIC_KEY=
FREEMIUS_SECRET_KEY=
# Optional bearer-token alternative to signed public/secret-key requests.
FREEMIUS_BEARER_TOKEN=

FRAMEPILOT_AI_PROVIDER_IMPL=langchain
