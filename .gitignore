# Dependencies
node_modules/
.pnpm-store/
**/.venv/
engine/python/.venv/
__pycache__/
*.py[cod]
.uv/

# Build output
dist/
build/
out/
.turbo/
*.tsbuildinfo
apps/desktop/release/
# Packaging staging dirs (scripts/copy-renderer.mjs, scripts/package-engine.mjs)
apps/desktop/renderer/
apps/desktop/engine-dist/
apps/desktop/engine-build/
# electron-builder's `buildResources` dir (electron-builder.yml) is a SOURCE
# directory (app icon, entitlements), not build output — track it despite the
# blanket `build/` rule above.
!apps/desktop/build/
!apps/desktop/build/**

# Test / coverage artifacts (reports/ tree is tracked but generated contents are not)
coverage/
.nyc_output/
playwright-report/
test-results/
reports/coverage/*
reports/test/*
reports/render/*
reports/e2e/*
# Per-turn agent event dumps from `mission-baseline.mjs --dump-events`: megabytes of raw
# stream, useful while diagnosing one run and worthless a week later. The measurement
# SUMMARIES beside them (`*-orchestration*.json`, `mission-score.json`) are the evidence
# and stay tracked.
reports/system-mission/runs/*
# Playwright writes failure screenshots/traces here; only the run pointer is tracked.
reports/e2e-results/*
!reports/e2e-results/.last-run.json
!reports/**/.gitkeep
!reports/**/README.md

# Foundation real-provider eval captures (docs/quality/foundation-real-eval/README.md):
# generated per-run evidence, not auto-committed by the capture workflow.
docs/quality/foundation-real-eval/*.json
!docs/quality/foundation-real-eval/README.md

# Local media + project data (never commit user media)
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3
*.aac
!tests/fixtures/**
!engine/python/tests/fixtures/**
projects/
!apps/desktop/electron/projects/
*.fp.json
!**/fixtures/**/*.fp.json
!**/__fixtures__/**/*.fp.json

# Generated user output must never become repository content.
renders/
exports/
**/renders/
**/exports/

# Derived "project brain" artifacts (plan B0; rebuildable, never canonical).
# Covered incidentally by `projects/` only while the derived dir lives there —
# FRAMEPILOT_PROJECTS_ROOT can point anywhere, and these carry user content:
# extracted frames are stills of the user's footage, memory/*.md is their words.
.framepilot-derived/
.framepilot/
brain.sqlite
brain.sqlite-wal
brain.sqlite-shm

# Env / secrets
.env
.env.*
!.env.example

# Local signing and service-account credentials. Public-release builds receive
# signing material from GitHub Actions secrets, never from tracked files.
*.p12
*.pfx
*.mobileprovision
*.keystore
*.jks
service-account*.json
credentials.json

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.log
logs/
tests/e2e/.tmp-preview-spike-fixtures/
.coverage

output.txt
terminal-history.txt

# Dev-only tool/capability run log (FRAMEPILOT_RUNS_LOG, see run-log.ts).
framepilot.runs.jsonl

goal.md
run.md

# Local-only research notes, not for commit.
TOOLS_REPORT.md
TOOL_REPORT.md
PERSONA.md

# Private advisory/application material, never committed.
advisories/

# mission fixtures: real media, never committed (plan/system-mission)
tests/fixtures/mission/**
!tests/fixtures/mission/README.md
!tests/fixtures/mission/fetch-fixtures.sh
!tests/fixtures/mission/manifest.json
!tests/fixtures/mission/projects/
!tests/fixtures/mission/projects/**
tests/fixtures/mission/projects/*.fp.json
# Rendered exports are test OUTPUT, not fixtures: `export-matrix.spec.ts` and the
# benchmarks write them on every run, so tracking them added 376 MB of churning
# binaries that nothing ever reads back.
tests/fixtures/mission/projects/exports/
# The media itself is the maintainer's real camera files — hundreds of MB each, and
# `fetch-fixtures.sh` regenerates the synthetic ones. They were never meant to be in
# the repo; a `git add -A` pulled 439 of them (3.4 GB) in before this rule existed,
# which is also what made the branch too large to push.
tests/fixtures/mission/projects/media/
# Derived caches and the per-project AI memory DB: regenerated on demand, and the
# sqlite churns several MB on every run.
tests/fixtures/mission/projects/.framepilot-derived/
tests/fixtures/mission/projects/**/brain.sqlite
tests/fixtures/mission/projects/**/sidecars/
