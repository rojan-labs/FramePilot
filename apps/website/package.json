{
  "name": "@framepilot/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FramePilot marketing website — landing, pricing (Freemius), blog, downloads (Next.js App Router).",
  "license": "SEE LICENSE IN ../../LICENSE",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next dev -p 4321",
    "prebuild": "node --env-file-if-exists=../../.env --import tsx scripts/fetch-pricing.ts",
    "build": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next build",
    "start": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next start -p 4321",
    "generate:og": "node --import tsx scripts/generate-og.ts",
    "fetch:pricing": "node --env-file-if-exists=../../.env --import tsx scripts/fetch-pricing.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "geist": "^1.3.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.460.0",
    "next": "^15.1.6",
    "reading-time": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "shiki": "^1.24.0",
    "unified": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.9.0",
    "satori": "^0.12.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
