# FramePilot web-editor — local dev environment
#
# Copy to `.env` (gitignored) and adjust as needed. Vite only exposes vars
# prefixed `VITE_` to the browser bundle — see `vite.config.ts`'s no-keys-in-
# bundle rule; only non-secret values (URLs, feature flags) belong here.

# The Python analysis-engine sidecar's base URL. `analyze_silence`,
# `detect_scenes`, and `detect_beats` need this sidecar; without it (or with
# this var unset) the AI layer reports an honest "no analysis engine is
# connected" failure instead of fabricating a result — it never silently no-ops.
#
# The desktop app doesn't need this: it always spawns and health-probes its
# own sidecar (`apps/desktop/electron/main.ts`). In the plain browser dev
# server, run the sidecar yourself (`pnpm --filter engine-python dev` or
# `uv run framepilot serve --host 127.0.0.1 --port 8765` from `engine/python`)
# and point this at it. Defaults to the same host/port the desktop shell uses
# (`DEFAULT_ENGINE_HOST`/`DEFAULT_ENGINE_PORT` in `main.ts`) when unset.
VITE_FRAMEPILOT_PYTHON_API_URL=http://127.0.0.1:8765

# Program monitor compositor (RD2.1): `layers` (N-layer WebGL2 compositor driven by
# the frame plan) or `legacy` (flat-EDL engine + DOM fallback, the kill switch until
# RD3). Unset: dev/test builds use `layers`, production builds use `legacy`.
VITE_FRAMEPILOT_PREVIEW_COMPOSITOR=

# Mask stack UI (RD2.1): `on` (monitor mask tools + Inspector mask panel) or `off` (kill
# switch until RD3; saved masks still preview and export). Unset: dev/test `on`, production `off`.
VITE_FRAMEPILOT_MASK_TOOLS=

# AI masking tools (RD2.1): `on` offers the assistant the masking tools, `off` removes them from
# every run in the BROWSER build (kill switch until RD3). The desktop app's assistant runs in
# Electron's main process and reads FRAMEPILOT_AI_MASKING at runtime instead (root .env.example).
# Unset: dev/test `on`, production `off`.
VITE_FRAMEPILOT_AI_MASKING=
